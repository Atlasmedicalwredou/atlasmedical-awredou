
/* ATLAS MÉDICAL BY @WREDOU */

:root {
  --navy: #10243d;
  --navy-light: #193b59;
  --turquoise: #16b8ae;
  --turquoise-light: #e0f7f5;
  --white: #ffffff;
  --background: #f4f8fb;
  --text: #243447;
  --muted: #718096;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: var(--background);
  color: var(--text);
  line-height: 1.6;
}

header {
  background: var(--navy);
  color: var(--white);
  padding: 22px 18px;
}

button {
  cursor: pointer;
  border: none;
  border-radius: 12px;
  padding: 12px 18px;
  font-weight: 600;
  background: var(--turquoise);
  color: var(--white);
}

button:hover {
  opacity: 0.9;
}

a {
  color: var(--turquoise);
  text-decoration: none;
}

.container {
  width: 100%;
  max-width: 1100px;
  margin: auto;
  padding: 20px;
}

.card {
  background: var(--white);
  border-radius: 16px;
  padding: 20px;
  margin-bottom: 16px;
  box-shadow: 0 4px 16px rgba(16, 36, 61, 0.06);
}

h1, h2, h3 {
  color: var(--navy);
  line-height: 1.3;
}

header h1 {
  color: var(--white);
}

.subtitle {
  color: var(--muted);
}

.module-card {
  border-left: 4px solid var(--turquoise);
  transition: transform 0.2s ease;
}

.module-card:hover {
  transform: translateY(-3px);
}

input, textarea, select {
  width: 100%;
  padding: 12px;
  border: 1px solid #dce5ed;
  border-radius: 10px;
  font: inherit;
  margin-bottom: 12px;
}

footer {
  background: var(--navy);
  color: var(--white);
  text-align: center;
  padding: 22px;
  margin-top: 35px;
}

@media (max-width: 600px) {
  .container {
    padding: 14px;
  }

  h1 {
    font-size: 25px;
  }

  .card {
    padding: 16px;
  }

  button {
    width: 100%;
  }
}

